---
import Layout from '../layouts/Layout.astro';
import LegalSpendBars from '../components/LegalSpendBars.astro';
import StatIcon from '../components/StatIcon.astro';
import SourcesList from '../components/SourcesList.astro';
import { home } from '../content/home';
import { callToAction, callToActionPaths } from '../content/call-to-action';
import { pageSourceIds } from '../content/sources';
import { siteConfig } from '../site.config';
import type { Lang } from '../content/ui';
import { ui } from '../content/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = home[lang];
const nav = ui[lang].nav;
const cta = callToAction[lang];
const ctaPaths = callToActionPaths[lang];
const about = siteConfig.about[lang];
const sourceAnchors =
  lang === 'fr'
    ? [
        { href: '#sources-home', label: 'SOFI / états' },
        { href: '#sources-home', label: 'données effectif' },
        { href: '#sources-home', label: 'lettre ministère' },
      ]
    : [
        { href: '#sources-home', label: 'SOFI / statements' },
        { href: '#sources-home', label: 'enrolment data' },
        { href: '#sources-home', label: 'Ministry letter' },
      ];
---

<Layout lang={lang} title={t.title} description={t.description} path={path}>
  <section class="election-banner">
    <div class="container-page election-banner-inner">
      <div class="election-copy">
        <p class="election-eyebrow">{cta.bannerEyebrow}</p>
        <p class="election-title font-display">{cta.bannerTitle}</p>
        <p class="election-body">{cta.bannerBody}</p>
      </div>
      <a class="btn-primary election-cta" href={ctaPaths.hub}>{cta.bannerCta}</a>
    </div>
  </section>

  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        poster="/images/hero-poster.jpg"
        data-hero-video
      >
        <source src="/video/courtroom.mp4" type="video/mp4" />
      </video>
      <div class="hero-veil"></div>
    </div>
    <div class="container-page hero-content">
      <p class="eyebrow rise-in">{t.heroEyebrow}</p>
      <h1 class="font-display rise-in rise-in-delay-1">
        <span>{t.heroLine1}</span>
        <span class="heat">{t.heroLine2}</span>
      </h1>
      <p class="support rise-in rise-in-delay-2">{t.heroSupport}</p>
      <div class="cta-row rise-in rise-in-delay-3">
        <a class="btn-primary" href={ctaPaths.hub}>{cta.bannerCta}</a>
        <a class="btn-secondary" href={lang === 'fr' ? '/frais-juridiques' : '/en/legal-fees'}>{nav.evidence}</a>
      </div>
    </div>
    <div class="hero-bars rise-in rise-in-delay-3">
      <LegalSpendBars
        lang={lang}
        caption={t.barsCaption}
        totalLabel={t.barsTotalLabel}
        fullBleed
      />
    </div>
  </section>

  <section class="section stats-band">
    <div class="container-page stats-grid">
      {
        t.stats.map((stat, i) => (
          <article class:list={['stat', `stat-${stat.icon}`]}>
            <div class="stat-top">
              <StatIcon kind={stat.icon} />
              <div class="mega-stat heat">{stat.value}</div>
            </div>
            <p>
              {stat.label}
              <a class="cite" href={sourceAnchors[i]?.href ?? '#sources-home'}>[{i + 1}]</a>
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="photo-break" style="background-image:url('/images/classroom.jpg')">
    <div class="photo-veil"></div>
    <div class="container-page photo-copy">
      <p class="photo-caption">{t.photoCaption}</p>
      <p class="photo-highlight">{t.photoHighlight}</p>
      <a class="text-link photo-cta" href={lang === 'fr' ? '/frais-juridiques' : '/en/legal-fees'}>
        {t.photoCta} →
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="reading">
        <h2 class="font-display">{t.arcEnrol.title}</h2>
        <p>{t.arcEnrol.body}</p>
        <blockquote class="pull-quote">
          <p>“{t.arcEnrol.quote}”</p>
          <cite>{t.arcEnrol.quoteAttr}</cite>
        </blockquote>
        <a class="text-link" href={lang === 'fr' ? '/effectif' : '/en/enrolment'}>{t.arcEnrol.cta} →</a>
      </div>
    </div>
  </section>

  <section class="section panel">
    <div class="container-page">
      <div class="reading">
        <h2 class="font-display">{t.arcDeficit.title}</h2>
        <p>{t.arcDeficit.body}</p>
      </div>
    </div>
  </section>

  <section class="section panel">
    <div class="container-page">
      <div class="reading">
        <h2 class="font-display">{t.ask.title}</h2>
        <ol class="ask-list">
          {
            t.ask.items.map((item, i) => (
              <li class="ask-item">
                <span class="ask-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <p class="ask-text">{item}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section panel" aria-labelledby="about-heading">
    <div class="container-page">
      <div class="reading about-block">
        <h2 id="about-heading" class="font-display">{about.title}</h2>
        <p>{about.body}</p>
      </div>
    </div>
  </section>

  <section class="section" id="sources-home">
    <div class="container-page">
      <div class="reading">
        <h2 class="font-display">{t.faqTitle}</h2>
        <div class="faq">
          {
            t.faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
        <SourcesList lang={lang} ids={pageSourceIds.home} intro={t.sourcesNote} />
      </div>
    </div>
  </section>
</Layout>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    const mq = window.matchMedia('(max-width: 819px)');
    const sync = () => {
      if (mq.matches) {
        video.removeAttribute('autoplay');
        video.pause();
        video.removeAttribute('src');
        video.load();
        video.style.display = 'none';
        const media = video.parentElement;
        if (media) {
          media.classList.add('hero-media-poster');
        }
      }
    };
    sync();
    mq.addEventListener('change', sync);
  }
</script>

<style>
  .election-banner {
    background:
      linear-gradient(90deg, rgba(253, 62, 18, 0.18), rgba(0, 0, 0, 0.55)),
      #120806;
    border-bottom: 1px solid rgba(253, 62, 18, 0.35);
    padding: 1rem 0;
  }
  .election-banner-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }
  .election-eyebrow {
    margin: 0 0 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    font-weight: 700;
    color: #ffb4a4;
  }
  .election-title {
    margin: 0 0 0.35rem;
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    letter-spacing: -0.03em;
  }
  .election-body {
    margin: 0;
    max-width: 40rem;
    color: rgba(245, 245, 242, 0.88);
    line-height: 1.45;
    font-size: 0.98rem;
  }
  .election-cta {
    text-decoration: none;
    flex-shrink: 0;
  }
  .about-block p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(245, 245, 242, 0.9);
  }
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 5rem 0 2.5rem;
    overflow: visible;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.05);
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.72) 45%, rgba(0, 0, 0, 0.94) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.55), transparent 55%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    color: var(--color-mute);
    margin: 0 0 1rem;
  }
  h1 {
    display: grid;
    gap: 0.15rem;
    font-size: clamp(2.6rem, 9vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 1.1rem;
    max-width: 14ch;
  }
  .support {
    max-width: 42rem;
    font-size: 1.1rem;
    line-height: 1.55;
    color: rgba(245, 245, 242, 0.88);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 2.25rem;
  }
  .hero-bars {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 0.5rem;
  }
  .stats-band {
    background: var(--color-panel);
    border-block: 1px solid rgba(245, 245, 242, 0.08);
  }
  .stats-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 800px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  .stat {
    padding: 1.35rem 1.25rem;
    background: rgba(0, 0, 0, 0.35);
    border-top: 3px solid var(--color-heat);
    min-height: 100%;
  }
  .stat-top {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }
  .stat .mega-stat {
    font-size: clamp(2rem, 5.5vw, 3.4rem);
  }
  .stat p {
    color: var(--color-snow);
    margin: 0;
    max-width: none;
    line-height: 1.45;
    font-weight: 700;
    font-size: clamp(1rem, 1.8vw, 1.12rem);
  }
  .prose-block h2,
  .panel h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }
  section h2.font-display {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .reading p,
  .panel .reading p {
    font-size: 1.12rem;
    line-height: 1.65;
    color: rgba(245, 245, 242, 0.9);
  }
  .panel {
    background: var(--color-panel);
  }
  .photo-break {
    position: relative;
    min-height: clamp(68vh, 78vh, 820px);
    background-size: cover;
    background-position: center 35%;
    display: flex;
    align-items: flex-end;
    padding-block: 0;
  }
  .photo-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0.08) 42%, rgba(0, 0, 0, 0.55) 72%, rgba(0, 0, 0, 0.88) 100%);
  }
  .photo-copy {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    width: 100%;
    padding-block: 2.25rem 2.75rem;
  }
  .photo-caption {
    font-size: clamp(1.65rem, 4.2vw, 2.55rem);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.85rem;
    line-height: 1.12;
    color: #fff;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.45);
  }
  .photo-highlight {
    margin: 0 0 1.15rem;
    font-size: clamp(1.05rem, 2.2vw, 1.28rem);
    font-weight: 600;
    line-height: 1.45;
    max-width: 36rem;
    color: #e8dcc8;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }
  .photo-cta {
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    padding-bottom: 0.1rem;
  }
  .photo-cta:hover {
    color: #e8dcc8;
    border-bottom-color: #e8dcc8;
  }
  .text-link {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--color-heat);
    font-weight: 600;
    text-decoration: none;
  }
  .pull-quote {
    margin: 1.75rem 0 1.25rem;
    padding: 1.25rem 0 1.25rem 1.25rem;
    border-left: 3px solid var(--color-heat);
    max-width: none;
  }
  .pull-quote p {
    margin: 0;
    font-size: clamp(1.15rem, 2.4vw, 1.35rem);
    line-height: 1.45;
    font-style: italic;
    color: var(--color-snow);
  }
  .pull-quote cite {
    display: block;
    margin-top: 0.85rem;
    font-style: normal;
    font-size: 0.9rem;
    color: var(--color-mute);
  }
  .ask-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
    max-width: none;
  }
  .ask-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 1.15rem;
    align-items: start;
    padding: 1.15rem 1.2rem;
    background: rgba(0, 0, 0, 0.35);
    border-left: 3px solid var(--color-heat);
  }
  .ask-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-heat);
    padding-top: 0.1rem;
  }
  .ask-text {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.5;
    color: var(--color-snow);
  }
  .faq {
    display: grid;
    gap: 0.75rem;
  }
  details {
    border-bottom: 1px solid rgba(245, 245, 242, 0.12);
    padding: 0.85rem 0;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
  details p {
    color: rgba(245, 245, 242, 0.85);
    line-height: 1.6;
  }
  .sources-note {
    color: var(--color-mute);
    font-size: 0.9rem;
    margin-top: 2rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
    .hero-media,
    .hero-media-poster {
      background: #000 url('/images/hero-poster.jpg') center / cover;
    }
  }
  .hero-media-poster {
    background: #000 url('/images/hero-poster.jpg') center / cover;
  }
</style>
