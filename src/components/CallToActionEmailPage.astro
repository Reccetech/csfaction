---
import Layout from '../layouts/Layout.astro';
import { callToAction, callToActionPaths } from '../content/call-to-action';
import { activeCandidates, electionMeta, electionRegions } from '../content/candidates';
import type { Lang } from '../content/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = callToAction[lang];
const paths = callToActionPaths[lang];

const draftPayload = JSON.stringify({
  subject: t.draftSubject,
  body: t.draftBody,
  copied: t.copied,
});

function mailtoHref(email: string): string {
  const subject = encodeURIComponent(t.draftSubject);
  const body = encodeURIComponent(t.draftBody);
  return `mailto:${email}?subject=${subject}&body=${body}`;
}
---

<Layout lang={lang} title={t.emailPageTitle} description={t.emailPageDescription} path={path}>
  <section class="section email-page" data-email-page data-draft={draftPayload}>
    <div class="container-page">
      <p class="back"><a href={paths.hub}>{t.backHub}</a></p>
      <header class="page-head">
        <h1 class="font-display page-title">{t.emailH1}</h1>
        <p class="lead">{t.emailLead}</p>
      </header>

      <div class="draft reading">
        <h2 class="font-display">{t.draftTitle}</h2>
        <div class="draft-actions">
          <button class="btn-secondary" type="button" data-copy="subject">{t.copySubject}</button>
          <button class="btn-primary" type="button" data-copy="body">{t.copyBody}</button>
        </div>
        <p class="draft-label">Subject / Objet</p>
        <pre class="draft-subject" data-draft-subject>{t.draftSubject}</pre>
        <p class="draft-label">Message</p>
        <pre class="draft-body" data-draft-body>{t.draftBody}</pre>
      </div>

      <div class="contacts">
        <h2 class="font-display contacts-title">{t.contactsTitle}</h2>
        <p class="contacts-note">
          {t.contactsNote}{' '}
          <a href={electionMeta.candidatesUrl} target="_blank" rel="noopener noreferrer">
            {t.candidatesLink}
            <span class="sr-only"> {t.opensInNewTab}</span>
          </a>
        </p>
        <p class="verified">{t.lastVerifiedLabel}</p>
        <p class="sr-only" aria-live="polite" data-live-status></p>

        {
          electionRegions.map((region) => {
            const regionCandidates = activeCandidates.filter((c) => c.regionId === region.id);
            return (
              <section class="region">
                <h3 class="region-title">{lang === 'fr' ? region.fr : region.en}</h3>
                {regionCandidates.length === 0 ? (
                  <p class="empty">{t.noCandidates}</p>
                ) : (
                  <ul class="candidate-list">
                    {regionCandidates.map((c) => (
                      <li class="candidate">
                        <p class="candidate-name font-display">{c.name}</p>
                        <p class="candidate-line">
                          <span class="k">{t.emailLabel}:</span>{' '}
                          <a href={`mailto:${c.email}`}>{c.email}</a>
                        </p>
                        {c.phone ? (
                          <p class="candidate-line">
                            <span class="k">{t.phoneLabel}:</span> {c.phone}
                          </p>
                        ) : null}
                        {c.socials?.length ? (
                          <p class="candidate-line">
                            <span class="k">{t.socialsLabel}:</span>{' '}
                            {c.socials.map((s, i) => (
                              <>
                                {i > 0 ? ', ' : ''}
                                <a href={s.href} target="_blank" rel="noopener noreferrer">
                                  {s.label}
                                  <span class="sr-only"> {t.opensInNewTab}</span>
                                </a>
                              </>
                            ))}
                          </p>
                        ) : null}
                        <a class="text-mail" href={mailtoHref(c.email)}>
                          {t.mailCandidate} →
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            );
          })
        }
      </div>

      <div class="next-steps reading">
        <h2 class="font-display">{lang === 'fr' ? 'Ensuite' : 'Next'}</h2>
        <ul>
          <li>
            <a href={paths.vote}>{lang === 'fr' ? 'Voir comment voter' : 'See how to vote'}</a>
          </li>
          <li>
            <button class="share-btn" type="button" data-share-page>
              {lang === 'fr' ? 'Partager cette page' : 'Share this page'}
            </button>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  const root = document.querySelector('[data-email-page]');
  if (root instanceof HTMLElement) {
    const draft = JSON.parse(root.dataset.draft || '{}') as {
      subject: string;
      body: string;
      copied: string;
    };

    const live = root.querySelector('[data-live-status]');

    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const kind = button.dataset.copy;
        const text = kind === 'subject' ? draft.subject : draft.body;
        try {
          await navigator.clipboard.writeText(text);
          const original = button.textContent;
          button.textContent = draft.copied;
          if (live) live.textContent = draft.copied;
          window.setTimeout(() => {
            button.textContent = original;
          }, 1600);
        } catch {
          const el = root.querySelector(kind === 'subject' ? '[data-draft-subject]' : '[data-draft-body]');
          if (el) {
            const range = document.createRange();
            range.selectNodeContents(el);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
          }
        }
      });
    });
  }

  const share = document.querySelector('[data-share-page]');
  if (share instanceof HTMLButtonElement) {
    share.addEventListener('click', async () => {
      const url = window.location.href;
      const live = document.querySelector('[data-live-status]');
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url });
          return;
        } catch {
          /* fall through */
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        const msg = share.textContent?.includes('Partager') ? 'Lien copié' : 'Link copied';
        share.textContent = msg;
        if (live) live.textContent = msg;
      } catch {
        /* ignore */
      }
    });
  }
</script>

<style>
  .email-page {
    padding-bottom: clamp(4rem, 10vw, 6rem);
  }
  .back {
    margin: 0 0 1rem;
  }
  .back a {
    color: var(--color-mute);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--color-snow);
  }
  .page-head {
    margin-bottom: 2rem;
    max-width: 44rem;
  }
  .page-title {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    letter-spacing: -0.04em;
    margin: 0 0 1rem;
    line-height: 1.05;
  }
  .lead {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.6;
    color: rgba(245, 245, 242, 0.9);
  }
  .draft {
    margin-bottom: 2.75rem;
    padding: 1.25rem 1.2rem 1.4rem;
    background: rgba(0, 0, 0, 0.35);
    border-left: 3px solid var(--color-heat);
  }
  .draft h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.35rem, 3vw, 1.7rem);
  }
  .draft-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }
  .draft-actions button {
    cursor: pointer;
  }
  .draft-label {
    margin: 0.85rem 0 0.35rem;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .draft-subject,
  .draft-body {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-sans);
    font-size: 0.98rem;
    line-height: 1.55;
    color: rgba(245, 245, 242, 0.92);
  }
  .contacts-title {
    margin: 0 0 0.65rem;
    font-size: clamp(1.45rem, 3.2vw, 1.9rem);
  }
  .contacts-note {
    margin: 0 0 0.5rem;
    color: var(--color-mute);
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 50rem;
  }
  .contacts-note a {
    color: var(--color-heat);
    font-weight: 600;
  }
  .verified {
    margin: 0 0 1.75rem;
    font-size: 0.9rem;
    color: var(--color-mute);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .region {
    margin-bottom: 2rem;
  }
  .region-title {
    margin: 0 0 0.85rem;
    font-size: 1.15rem;
    color: var(--color-heat);
  }
  .empty {
    margin: 0;
    color: var(--color-mute);
  }
  .candidate-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 800px) {
    .candidate-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .candidate {
    padding: 1rem 1.05rem;
    background: rgba(245, 245, 242, 0.04);
    border: 1px solid rgba(245, 245, 242, 0.1);
  }
  .candidate-name {
    margin: 0 0 0.55rem;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .candidate-line {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .candidate-line a {
    color: var(--color-snow);
  }
  .k {
    color: var(--color-mute);
  }
  .text-mail {
    display: inline-block;
    margin-top: 0.55rem;
    color: var(--color-heat);
    font-weight: 600;
    text-decoration: none;
  }
  .next-steps {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(245, 245, 242, 0.12);
  }
  .next-steps h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }
  .next-steps ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.45rem;
  }
  .next-steps a,
  .share-btn {
    color: var(--color-heat);
    font-weight: 600;
  }
  .share-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }
</style>
