---
import type { Lang } from '../content/ui';
import { formatCadCompact, juristesSoFiSeries } from '../site.config';

interface Props {
  lang: Lang;
  title: string;
  note?: string;
  sourceHref?: string;
  sourceLabel?: string;
}

const { lang, title, note, sourceHref, sourceLabel } = Astro.props;
const yearsLegend = lang === 'fr' ? 'Années' : 'Years';
const width = 720;
const height = 360;
const pad = { top: 36, right: 18, bottom: 78, left: 52 };
const innerW = width - pad.left - pad.right;
const innerH = height - pad.top - pad.bottom;
const amounts = juristesSoFiSeries.map((d) => d.amount);
const max = Math.max(...amounts) * 1.08;
const min = 0;
const x = (i: number) => pad.left + (i * innerW) / (juristesSoFiSeries.length - 1);
const y = (v: number) => pad.top + innerH - ((v - min) / (max - min)) * innerH;
const points = juristesSoFiSeries.map((d, i) => `${x(i)},${y(d.amount)}`).join(' ');
const area = `${pad.left},${pad.top + innerH} ${points} ${x(juristesSoFiSeries.length - 1)},${pad.top + innerH}`;
const yTicks = [0, 0.25, 0.5, 0.75, 1].map((t) => min + t * (max - min));
---

<figure class="line-chart" data-case-line>
  <figcaption>{title}</figcaption>
  <div class="chart-scroll">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title}>
      <defs>
        <linearGradient id="feeFill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#FD3E12" stop-opacity="0.35"></stop>
          <stop offset="100%" stop-color="#FD3E12" stop-opacity="0.02"></stop>
        </linearGradient>
      </defs>
      {
        yTicks.map((tick) => (
          <g>
            <line
              x1={pad.left}
              x2={width - pad.right}
              y1={y(tick)}
              y2={y(tick)}
              stroke="rgba(245,245,242,0.1)"
              stroke-width="1"
            />
            <text x={pad.left - 8} y={y(tick) + 4} text-anchor="end" fill="#8A8A86" font-size="11">
              {formatCadCompact(Math.round(tick), lang)}
            </text>
          </g>
        ))
      }
      <polygon fill="url(#feeFill)" points={area}></polygon>
      <polyline
        fill="none"
        stroke="#FD3E12"
        stroke-width="3.5"
        stroke-linejoin="round"
        stroke-linecap="round"
        points={points}
        class="fee-line"
      ></polyline>
      {
        juristesSoFiSeries.map((d, i) => (
          <g class="point">
            <circle cx={x(i)} cy={y(d.amount)} r="5.5" fill="#000" stroke="#FD3E12" stroke-width="2.5"></circle>
            <text
              class="value-label"
              x={x(i)}
              y={y(d.amount) - 12}
              text-anchor="middle"
              fill="#F5F5F2"
              font-size="11"
              font-weight="700"
            >
              {formatCadCompact(d.amount, lang)}
            </text>
            <text
              class="year-label"
              x={x(i)}
              y={height - 40}
              text-anchor="middle"
              fill="#8A8A86"
              font-size="11"
            >
              {d.year}
            </text>
          </g>
        ))
      }
      <text
        x={pad.left + innerW / 2}
        y={height - 12}
        text-anchor="middle"
        fill="#8A8A86"
        font-size="13"
        font-weight="600"
        letter-spacing="0.04em"
      >
        {yearsLegend}
      </text>
    </svg>
  </div>

  <ul class="mobile-legend" aria-label={title}>
    {
      juristesSoFiSeries.map((d) => (
        <li>
          <span>{d.year}</span>
          <strong class="heat">{formatCadCompact(d.amount, lang)}</strong>
        </li>
      ))
    }
  </ul>

  {
    (note || sourceHref) && (
      <p class="note">
        {note}
        {note && sourceHref && ' '}
        {sourceHref && (
          <a href={sourceHref} target="_blank" rel="noopener noreferrer">
            {sourceLabel ?? (lang === 'fr' ? 'Voir la source' : 'See source')}
          </a>
        )}
      </p>
    )
  }
</figure>

<style>
  .line-chart {
    margin: 1.35rem 0 0;
    padding: clamp(1rem, 3vw, 1.35rem);
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(245, 245, 242, 0.1);
  }
  figcaption {
    color: var(--color-mute);
    font-size: 0.9rem;
    margin: 0 0 0.85rem;
  }
  .chart-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  svg {
    width: 100%;
    min-width: 520px;
    height: auto;
    display: block;
  }
  .mobile-legend {
    display: none;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    gap: 0.55rem;
  }
  .mobile-legend li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(245, 245, 242, 0.1);
    font-size: 0.95rem;
  }
  .mobile-legend strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  @media (max-width: 640px) {
    .value-label {
      display: none;
    }
    .mobile-legend {
      display: grid;
    }
  }
  .note {
    color: var(--color-mute);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0.95rem 0 0;
    max-width: 46rem;
  }
  .note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .note a:hover {
    color: var(--color-heat);
  }
  .fee-line {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: draw-line 1.4s ease forwards;
  }
  @keyframes draw-line {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fee-line {
      animation: none;
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }
</style>
