---
import Layout from '../layouts/Layout.astro';
import { callToAction, callToActionPaths } from '../content/call-to-action';
import { electionMeta, electionStatusCopy } from '../content/candidates';
import type { Lang } from '../content/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = callToAction[lang];
const paths = callToActionPaths[lang];
const status = electionStatusCopy(lang);
const electionsOfficialUrl = lang === 'fr' ? electionMeta.electionsUrl : electionMeta.electionsUrlEn;
---

<Layout lang={lang} title={t.votePageTitle} description={t.votePageDescription} path={path}>
  <section class="section vote-page">
    <div class="container-page">
      <p class="back"><a href={paths.hub}>{t.backHub}</a></p>
      <header class="page-head">
        <p class="status-pill">{status.short}</p>
        <h1 class="font-display page-title">{t.voteH1}</h1>
        <p class="lead">{t.voteLead}</p>
      </header>

      <div class="reading">
        <aside class="eligibility" aria-labelledby="eligibility-heading">
          <h2 id="eligibility-heading" class="font-display">{t.eligibilityTitle}</h2>
          <p>{t.eligibilityIntro}</p>
          <ul>
            {t.eligibility.map((item) => <li>{item}</li>)}
          </ul>
          <p class="eligibility-note">{t.eligibilityNote}</p>
          <p>
            <a href={electionsOfficialUrl} target="_blank" rel="noopener noreferrer">
              {t.eligibilityLink}
              <span class="sr-only"> {t.opensInNewTab}</span>
            </a>
          </p>
        </aside>

        <h2 class="font-display">{t.voteStepsTitle}</h2>
        <ol class="steps">
          <li>
            {t.voteBiosStep}{' '}
            <a href={electionMeta.candidatesUrl} target="_blank" rel="noopener noreferrer">
              {t.candidatesLink}
              <span class="sr-only"> {t.opensInNewTab}</span>
            </a>
          </li>
          {t.voteSteps.map((step) => <li>{step}</li>)}
        </ol>

        <p class="verified">{t.lastVerifiedLabel}</p>

        <div class="tip">
          <h3 class="font-display">{t.voteTipTitle}</h3>
          <p>{t.voteTipBody}</p>
        </div>

        <div class="links">
          <a class="btn-primary" href={electionMeta.candidatesUrl} target="_blank" rel="noopener noreferrer">
            {t.candidatesLink}
            <span class="sr-only"> {t.opensInNewTab}</span>
          </a>
          <a class="btn-secondary" href={`mailto:${electionMeta.electionsEmail}`}>{t.emailElections}</a>
          <a class="btn-secondary" href={paths.email}>{callToAction[lang].actionEmailCta}</a>
        </div>

        <div class="next-steps">
          <h3 class="font-display">{lang === 'fr' ? 'Ensuite' : 'Next'}</h3>
          <ul>
            <li>
              <a href={paths.email}>{lang === 'fr' ? 'Écrire aux candidat·e·s' : 'Email the candidates'}</a>
            </li>
            <li>
              <button class="share-btn" type="button" data-share-page>
                {lang === 'fr' ? 'Partager cette page' : 'Share this page'}
              </button>
            </li>
          </ul>
          <p class="sr-only" aria-live="polite" data-live-status></p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const share = document.querySelector('[data-share-page]');
  const live = document.querySelector('[data-live-status]');
  if (share instanceof HTMLButtonElement) {
    share.addEventListener('click', async () => {
      const url = window.location.href;
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url });
          return;
        } catch {
          /* fall through */
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        const msg = share.textContent?.includes('Partager') ? 'Lien copié' : 'Link copied';
        share.textContent = msg;
        if (live) live.textContent = msg;
      } catch {
        /* ignore */
      }
    });
  }
</script>

<style>
  .vote-page {
    padding-bottom: clamp(4rem, 10vw, 6rem);
  }
  .back {
    margin: 0 0 1rem;
  }
  .back a {
    color: var(--color-mute);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--color-snow);
  }
  .page-head {
    margin-bottom: 2rem;
    max-width: 44rem;
  }
  .status-pill {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-heat);
  }
  .page-title {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    letter-spacing: -0.04em;
    margin: 0 0 1rem;
    line-height: 1.05;
  }
  .lead {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.6;
    color: rgba(245, 245, 242, 0.9);
  }
  .reading h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
  }
  .eligibility {
    margin: 0 0 1.75rem;
    padding: 1.15rem 1.2rem;
    background: rgba(245, 245, 242, 0.05);
    border: 1px solid rgba(245, 245, 242, 0.12);
  }
  .eligibility h2 {
    margin: 0 0 0.65rem;
  }
  .eligibility p {
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }
  .eligibility ul {
    margin: 0 0 0.85rem;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.4rem;
  }
  .eligibility a {
    color: var(--color-heat);
    font-weight: 600;
  }
  .eligibility-note {
    color: var(--color-mute);
    font-size: 0.92rem;
  }
  .steps {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.75rem;
    max-width: none;
  }
  .steps li {
    line-height: 1.55;
    color: rgba(245, 245, 242, 0.9);
  }
  .steps a {
    color: var(--color-heat);
    font-weight: 600;
  }
  .verified {
    margin: 0 0 1.75rem;
    font-size: 0.9rem;
    color: var(--color-mute);
  }
  .tip {
    margin: 0 0 1.75rem;
    padding: 1.15rem 1.2rem;
    background: rgba(0, 0, 0, 0.35);
    border-left: 3px solid var(--color-heat);
  }
  .tip h3 {
    margin: 0 0 0.55rem;
    font-size: 1.2rem;
  }
  .tip p {
    margin: 0;
    line-height: 1.55;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .links a {
    text-decoration: none;
  }
  .next-steps {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(245, 245, 242, 0.12);
  }
  .next-steps h3 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }
  .next-steps ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.45rem;
  }
  .next-steps a,
  .share-btn {
    color: var(--color-heat);
    font-weight: 600;
  }
  .share-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
