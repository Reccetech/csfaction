---
import type { Lang } from '../content/ui';
import { pickSources, sourceLabel, type SourceId } from '../content/sources';

interface Props {
  lang: Lang;
  ids: readonly SourceId[];
  heading?: string;
  intro?: string;
}

const { lang, ids, heading, intro } = Astro.props;
const list = pickSources([...ids]);
const title =
  heading ?? (lang === 'fr' ? 'Sources et références' : 'Sources and references');
const typeLabel: Record<string, { fr: string; en: string }> = {
  primary: { fr: 'Document primaire', en: 'Primary document' },
  'official-statement': { fr: 'Déclaration officielle', en: 'Official statement' },
  news: { fr: 'Reportage', en: 'News report' },
  advocacy: { fr: 'Plaidoyer / syndicat', en: 'Advocacy / union' },
  commentary: { fr: 'Commentaire', en: 'Commentary' },
};
---

<aside class="sources" aria-label={title}>
  <h2 class="font-display sources-h">{title}</h2>
  {intro && <p class="intro">{intro}</p>}
  <ol>
    {
      list.map((s) => (
        <li>
          {s.sourceType ? (
            <span class="source-type">{typeLabel[s.sourceType]?.[lang] ?? s.sourceType}</span>
          ) : null}
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {sourceLabel(s, lang)}
            <span class="sr-only"> {lang === 'fr' ? '(nouvel onglet)' : '(opens in new tab)'}</span>
          </a>
          {s.note && <span class="note"> — {s.note[lang]}</span>}
        </li>
      ))
    }
  </ol>
</aside>

<style>
  .sources {
    margin: 3rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid rgba(245, 245, 242, 0.14);
    max-width: 46rem;
  }
  .sources-h {
    font-size: 1.15rem;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }
  .intro {
    color: var(--color-mute);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 1rem;
  }
  ol {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.65rem;
  }
  li {
    line-height: 1.45;
    font-size: 0.95rem;
  }
  .source-type {
    display: inline-block;
    margin-right: 0.45rem;
    padding: 0.1rem 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
    border: 1px solid rgba(245, 245, 242, 0.2);
  }
  a {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  a:hover {
    color: var(--color-heat);
  }
  .note {
    color: var(--color-mute);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
